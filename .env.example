# Copiar como .env y ajustar valores locales.
# URI de conexión a MongoDB (ver docs/MODELADO.md — base de datos: bmvll_db)
MONGODB_URI=mongodb://localhost:27017/bmvll_db

# JWT (login de ADMIN/LIBRARIAN) — generar un secreto propio, ej: openssl rand -base64 64
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_EXPIRATION_MS=28800000

# Bootstrap: crea este ADMIN al arrancar si no existe ningún usuario ADMIN (solo dev/local)
BOOTSTRAP_ADMIN_EMAIL=admin@bmvll.local
BOOTSTRAP_ADMIN_PASSWORD=changeme123
